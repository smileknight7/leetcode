   "source": [
    "# 斐波那契额数列\n",
    "\n",
    "\n",
    "def fib(n):\n",
    "    l = [0, 1]\n",
    "    for i in range(2, n + 1):\n",
    "        l.append(l[i - 1] + l[i - 2])\n",
    "    return l[n]\n",
    "\n",
    "print(fib(5))"
   ]
  }
 ],
